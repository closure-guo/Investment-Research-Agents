# ===== LLM 配置 =====

# LLM API Key（必填）— opencode zen/go OpenAI 兼容网关
LLM_API_KEY=your-api-key-here

# 深度模式模型名，litellm 格式（默认: openai/deepseek-v4.1-flash）
# 示例: openai/gpt-4o, anthropic/claude-sonnet-4-20250514
LLM_MODEL=openai/deepseek-v4.1-flash

# 快速/追问模式模型名（默认: openai/deepseek-v4.1-flash）
LLM_QUICK_MODEL=openai/deepseek-v4.1-flash

# API 端点（无代码默认值；配了 LLM_API_KEY 就必须同时给端点，否则启动即报
# IncompleteLLMConfigError——有意收紧见 5.1-B2。仅配 LLM_MODEL 不配 key 时
# 按模型前缀走官方端点，可省略本项）
LLM_BASE_URL=https://opencode.ai/zen/go/v1
# 备用 provider（可选；主端点 5xx/连接错误时按 fallback 链自动切换）。
# 必须同时给 model 与 base_url 才生效（只有 model = 半套配置，忽略）。
# LLM_FALLBACK_MODEL=openai/k3-256k
# LLM_FALLBACK_BASE_URL=https://api.kimi.com/coding/v1
# LLM_FALLBACK_API_KEY=your-fallback-key

# 思考模式 enabled / disabled（默认: enabled）
# LLM_THINKING=enabled

# 思考强度 low / high / max（默认: max）
# LLM_REASONING_EFFORT=max

# ===== 成本可观测性（2026-10-22）=====
# 模型价格（JSON，单位：美元 / 百万 token）。配置后执行
#   uv run python scripts/register_langfuse_model_prices.py --apply
# 把价格注册进 Langfuse，之后新 trace 的 totalCost 才有值（存量不回溯）。
# 不配置 = 成本保持 0（不编造默认价）。键写短名即可，openai/ 前缀自动兼容。
# LLM_MODEL_PRICES={"deepseek-v4.1-flash": {"input": 0.27, "output": 1.10}}

# ===== 版本可观测性（2026-10-22）=====
# 构建期注入 run-info 的 git_commit（镜像内无 .git，否则恒为 null）：
#   $env:GIT_COMMIT = git rev-parse HEAD; docker compose up -d --build
# 或在 .env 写 GIT_COMMIT=<sha>（compose 构建期替换使用）。

# ===== 自动选股分析 / 每日汇报（add-auto-pool-analysis-daily-brief）=====

# 自动选股分析开关（默认 1；0 = 零会话、零 LLM）
# AUTO_POOL_ANALYSIS_ENABLED=1

# 单日最多分析当日精选池前 N 只（默认 10，钳制 1-100）
# AUTO_POOL_ANALYSIS_MAX_SYMBOLS=10

# 每日汇报模型（可选；不设置时逐字段回退 LLM_MODEL/LLM_BASE_URL/LLM_API_KEY）
# DAILY_BRIEF_MODEL=openai/deepseek-v4.1-flash
# DAILY_BRIEF_BASE_URL=https://opencode.ai/zen/go/v1
# DAILY_BRIEF_API_KEY=

# ===== 输出与数据 =====

# 报告输出目录（默认: reports）
# REPORTS_DIR=reports

# 事件数据源 builtin / web / auto（默认: auto）
# EVENT_SOURCE=auto

# ===== 探班池盘后跑批（cohort，可选）=====
# 运维开关：默认未设置 = 关闭（不跑批、零 LLM 调用）。
# 置 1 才启用；关闭时定时任务仍注册，但触发即空转（runner 自门控）。
# COHORT_ENABLED=1

# 跑批时段（本地时区 Asia/Shanghai，仅工作日 mon-fri；默认 18:00）
# COHORT_HOUR=18
# COHORT_MINUTE=0

# 单轮 token 预算上限，累计达限后剩余标的记 skipped/budget（默认: 2000000）
# COHORT_MAX_TOKENS_PER_RUN=2000000

# 探班池快照路径（可选，默认: data/cohort/universe-v1.json）
# COHORT_UNIVERSE_PATH=data/cohort/universe-v1.json

# ===== Web 搜索（Tavily）=====
# 快速模式 web_search 工具需要，未配置则实时搜索不可用
# 获取: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ===== Langfuse 可观测性（可选）=====
# 配置后所有 LLM 调用将自动上报到 Langfuse，未配置则跳过
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
