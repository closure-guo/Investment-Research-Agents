flowchart TD

    START([START]) --> check_cache

    subgraph PREP[数据准备]
        check_cache["① check_cache<br/>查缓存"]
        fetch_data["② fetch_data<br/>多源回退拉取"]
        validate_financials["③ validate_financials<br/>勾稽校验"]
        compute_metrics["④ compute_metrics<br/>指标计算 + 技术指标 + 风控"]
    end

    subgraph LayerI[Layer I: Analyst Team]
        analysts_entry["analysts_entry<br/>记忆检索 memory_recall_entry"]
        technical_analyst["technical_analyst<br/>技术面分析"]
        macro_analyst["macro_analyst<br/>宏观分析"]
        fundamental_analyst["fundamental_analyst<br/>基本面分析"]
        sentiment_analyst["sentiment_analyst<br/>舆情分析"]
    end

    verify_citations["⑤ verify_citations<br/>引用校验"]

    subgraph LayerII[Layer II: Bull/Bear Debate]
        debate_r1_entry["R1 Entry"]
        bull_r1["bull_r1"]
        bear_r1["bear_r1"]
        debate_r2_entry["R2 Entry"]
        bull_r2["bull_r2"]
        bear_r2["bear_r2"]
        research_manager["research_manager<br/>研究结论"]
    end

    trader["⑥ trader<br/>交易决策"]
    validate_trade_prices["⑦ validate_trade_prices<br/>价位/理由校验"]

    subgraph LayerIV[Layer IV: Risk Management]
        risk_r1_entry["R1 Entry"]
        aggressive_r1["aggressive_r1"]
        conservative_r1["conservative_r1"]
        neutral_r1["neutral_r1"]
        risk_r2_entry["R2 Entry"]
        aggressive_r2["aggressive_r2"]
        conservative_r2["conservative_r2"]
        neutral_r2["neutral_r2"]
        risk_judge["risk_judge<br/>最终决策"]
    end

    fund_manager["⑧ fund_manager<br/>审批"]
    generate_report["⑨ generate_report<br/>报告生成"]
    generate_file["⑩ generate_file<br/>文件导出"]
    END([END])
    END_ERR([终止: 校验失败])
    END_GATE([终止: 价位门禁阻断])

    %% PREP 边
    check_cache -->|"MISS 首次"| fetch_data
    check_cache -->|"HIT 报表已有"| validate_financials
    fetch_data --> validate_financials
    validate_financials -->|"FAIL ✗"| END_ERR
    validate_financials -->|"PASS ✓"| compute_metrics
    compute_metrics --> analysts_entry

    %% Layer I
    analysts_entry -->|"Send 4 并行"| technical_analyst
    analysts_entry -->|"Send"| macro_analyst
    analysts_entry -->|"Send"| fundamental_analyst
    analysts_entry -->|"Send"| sentiment_analyst
    technical_analyst --> verify_citations
    macro_analyst --> verify_citations
    fundamental_analyst --> verify_citations
    sentiment_analyst --> verify_citations

    %% Citation 条件路由
    verify_citations -->|"PASS → render"| debate_r1_entry
    verify_citations -->|"FAIL → retry（默认停用）"| analysts_entry

    %% Layer II Debate
    debate_r1_entry -->|"Send"| bull_r1
    debate_r1_entry -->|"Send"| bear_r1
    bull_r1 --> debate_r2_entry
    bear_r1 --> debate_r2_entry
    debate_r2_entry -->|"Send"| bull_r2
    debate_r2_entry -->|"Send"| bear_r2
    bull_r2 --> research_manager
    bear_r2 --> research_manager

    %% Layer III
    research_manager --> trader
    trader --> validate_trade_prices
    validate_trade_prices -->|"FAIL ✗ 打回"| trader
    validate_trade_prices -->|"PASS ✓"| risk_r1_entry

    %% Layer IV Risk
    risk_r1_entry -->|"Send"| aggressive_r1
    risk_r1_entry -->|"Send"| conservative_r1
    risk_r1_entry -->|"Send"| neutral_r1
    aggressive_r1 --> risk_r2_entry
    conservative_r1 --> risk_r2_entry
    neutral_r1 --> risk_r2_entry
    risk_r2_entry -->|"Send"| aggressive_r2
    risk_r2_entry -->|"Send"| conservative_r2
    risk_r2_entry -->|"Send"| neutral_r2
    aggressive_r2 --> risk_judge
    conservative_r2 --> risk_judge
    neutral_r2 --> risk_judge

    %% Layer V + Report
    risk_judge -->|"gate PASS"| fund_manager
    risk_judge -->|"gate FAIL ✗"| END_GATE
    fund_manager -->|"approve/reject"| generate_report
    fund_manager -->|"return 退回（上限 1 次）"| trader
    generate_report --> generate_file
    generate_file --> END

    style PREP fill:#e8f5e9
    style LayerI fill:#e3f2fd
    style LayerII fill:#fff3e0
    style LayerIV fill:#fce4ec
    style verify_citations fill:#ff9800,color:#fff
    style validate_trade_prices fill:#ff9800,color:#fff
    style risk_judge fill:#ffb74d
    style fund_manager fill:#ab47bc,color:#fff
    style generate_report fill:#ef9a9a
    style generate_file fill:#ef9a9a
    style END_ERR fill:#ef5350,color:#fff
    style END_GATE fill:#ef5350,color:#fff
